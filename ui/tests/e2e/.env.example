# ==============================================================================
# Meshery UI E2E Tests Environment Variables
# ==============================================================================
# Copy this file to .env in the ui/ directory before running e2e tests.
# Usage: cp tests/e2e/.env.example .env
#
# Run tests with: npm run test:e2e
# ==============================================================================

# env $(cat .env | xargs)
# ------------------------------------------------------------------------------
# Meshery Server Configuration
# ------------------------------------------------------------------------------

# URL of the Meshery server instance to test against
# Default: http://localhost:9081
MESHERY_SERVER_URL=http://localhost:9081

# ------------------------------------------------------------------------------
# Remote Provider Configuration (Meshery Cloud)
# ------------------------------------------------------------------------------

# URL of the remote provider (Meshery Cloud)
# Default: https://cloud.meshery.io
REMOTE_PROVIDER_URL=https://cloud.meshery.io

# The chromium-meshery-provider project needs ONE of the two credential sets
# below - a token on its own, or both the email and the password. With neither,
# the remote-setup project fails and every test that depends on it does not run.
# The Local provider project needs neither.

# Provider token for API authentication - preferred, and the only path CI uses
# Obtain from: https://cloud.meshery.io (Settings > Security Tokens)
PROVIDER_TOKEN=

# User credentials for Meshery Cloud authentication
# Used only when PROVIDER_TOKEN is unset; set both or neither
REMOTE_PROVIDER_USER_EMAIL=
REMOTE_PROVIDER_USER_PASSWORD=

# ------------------------------------------------------------------------------
# Optional: Provider Selection
# ------------------------------------------------------------------------------

# Default provider to use for tests
# Valid values: Local, Meshery
# Default: Local
MESHERY_PROVIDER=Local

# ------------------------------------------------------------------------------
# CI Environment (automatically set in GitHub Actions)
# ------------------------------------------------------------------------------

# Set to 'true' when running in CI environment
# This affects error handling and test parallelization
# CI=true
