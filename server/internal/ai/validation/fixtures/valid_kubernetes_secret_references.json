{
  "schemaVersion": "designs.meshery.io/v1beta3",
  "name": "kubernetes-secret-references",
  "components": [{
    "id": "deployment",
    "component": {"kind": "Deployment", "version": "apps/v1"},
    "model": {"name": "kubernetes"},
    "configuration": {
      "imagePullSecrets": [{"name": "registry-credentials"}],
      "envFrom": [{"secretRef": {"name": "application-config"}}],
      "secretName": "application-tls"
    }
  }]
}
