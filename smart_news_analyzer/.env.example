# ============================================================
# SMART NEWS SUMMARIZER - Environment Configuration
# ============================================================

# Django Configuration
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,api.example.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-in-production

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=smart_news_db
DB_USER=postgres
DB_PASSWORD=postgres-password-change-me
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# Email Configuration (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# API Keys & Credentials
YOUTUBE_API_KEY=your-youtube-api-key
TWITTER_BEARER_TOKEN=your-twitter-api-token
TELEGRAM_SESSION_NAME=telegram_session
TELEGRAM_API_ID=your-telegram-api-id
TELEGRAM_API_HASH=your-telegram-api-hash

# External Service URLs
NLP_SERVICE_URL=http://nlp-service:8001
PREDICTION_SERVICE_URL=http://prediction-service:8002
SCRAPERS_WEBHOOK_URL=http://backend:8000/api/articles/webhook/

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000/api

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=

# Feature Flags
ENABLE_SCRAPING=True
ENABLE_NLP_ANALYSIS=True
ENABLE_PREDICTIONS=True

# Celery Configuration
CELERY_WORKERS=4
CELERY_BEAT_ENABLED=True

# Model Configuration
SUMMARIZER_MODEL=facebook/bart-large-cnn
SENTIMENT_MODEL=ProsusAI/finbert
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Scraper Configuration
SCRAPER_TIMEOUT=30
SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_CONCURRENT_REQUESTS=16
SCRAPY_PIPELINE_CONCURRENCY=2

# NLP Service Configuration
NLP_BATCH_SIZE=32
NLP_GPU_ENABLED=False

# Prediction Configuration
PREDICTION_CONFIDENCE_THRESHOLD=0.6
PREDICTION_UPDATE_INTERVAL=3600

# Nginx Configuration
NGINX_WORKER_PROCESSES=4
NGINX_WORKER_CONNECTIONS=2048

# Application Environment
ENVIRONMENT=production
DEPLOYMENT_TYPE=docker-compose

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Monitoring & Observability
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090
JAEGER_ENABLED=False
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
