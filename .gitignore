# UI
# No trailing slash: a git worktree has no ui/node_modules of its own and the
# documented workaround (AGENTS.md) is to symlink it from the primary checkout.
# A "node_modules/" pattern matches only directories, so the symlink shows up as
# untracked and lands in the next `git add -A`.
**/node_modules
**/out/

**/ui/playground/
ui/.next/
ui/out/
ui/.eslintcache
ui/node_modules/
ui/tests/e2e/.env
ui/next-env.d.ts

provider-ui/out/
provider-ui/.next/
provider-ui/node_modules/
provider-ui/.eslintcache

# mesheryctl
mesheryctl/cmd/mesheryctl/mesheryctl
mesheryctl/.meshery/
mesheryctl/mesheryctl
mesheryctl/default.profraw
main

# Meshery
cmd/meshery

log.txt

